{%- if page.template == 'podcast-channel' -%}
    {%- set channel = page -%}
{%- elseif page.template == 'podcast-series' -%}
    {%- set channel = page.parent -%}
{%- endif -%}
{%- if channel -%}
{%- set feed_image = channel.media[channel.header.podcast.itunes.image] ?: channel.media.images|first -%}
{%- if page.template == 'podcast-series' -%}
    {%- set feed_image = page.media[page.header.series.image] ?: page.media.images|first ?: feed_image -%}
{%- elseif not feed_image -%}
    {%- set first_series = page.collection({ 'items': '@self.descendants' }).ofType('podcast-series')|first -%}
    {%- if first_series -%}
        {%- set feed_image = first_series.media[first_series.header.series.image] ?: first_series.media.images|first -%}
    {%- endif -%}
{%- endif -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd">
<channel>
<title>{{ channel.header.podcast.title|e }}</title>
<link>{{ channel.header.podcast.link|e }}</link>
<language>{{ channel.header.podcast.channelLanguage|e }}</language>
<copyright>{{ channel.header.podcast.copyright|e }}</copyright>
<itunes:subtitle>{{ channel.header.podcast.itunes.subtitle|e }}</itunes:subtitle>
<itunes:author>{{ channel.header.podcast.itunes.author|e }}</itunes:author>
<itunes:summary>{{ (channel.header.podcast.itunes.summary ?: (channel.content ? channel.content : channel.header.podcast.description)|striptags)|e }}</itunes:summary>
<description>{{ channel.header.podcast.description|striptags|e }}</description>
<itunes:owner>
    <itunes:name>{{ channel.header.podcast.itunes.owner.name|e }}</itunes:name>
    <itunes:email>{{ channel.header.podcast.itunes.owner.email|e }}</itunes:email>
</itunes:owner>
{% if feed_image %}<itunes:image href="{{ (uri.base ~ feed_image.url(true))|e('html_attr') }}"/>{% endif %}
{% if channel.header.podcast.itunes.category %}
<itunes:category text="{{ channel.header.podcast.itunes.category|e('html_attr') }}">
    {% if channel.header.podcast.itunes.subcategory %}<itunes:category text="{{ channel.header.podcast.itunes.subcategory|e('html_attr') }}"/>{% endif %}
</itunes:category>
{% endif %}
<itunes:explicit>{{ channel.header.podcast.itunes.explicit }}</itunes:explicit>
{% set episode_items = page.template == 'podcast-series' ? '@self.children' : '@self.descendants' %}
{% set episodes = page.collection({ 'items': episode_items, 'order': {'by': 'date', 'dir': 'desc'} }).ofType('podcast-episode') %}
{% for episode in episodes %}
{% if episode.header.podcast.audio.meta or episode.header.audio_url %}
<item>
    <title>{{ episode.title|e }}</title>
    <link>{{ episode.url(true)|e }}</link>
    {% set episode_number = episode.header.podcast.episode_number ?: episode.header.episode_number %}
    {% if episode_number -%}
    <itunes:episode>{{ episode_number }}</itunes:episode>
    {% endif -%}
    <itunes:author>{{ episode.header.podcast.itunes.author|e }}</itunes:author>
    <itunes:subtitle>{{ episode.header.podcast.itunes.subtitle|e }}</itunes:subtitle>
    <itunes:summary>{{ episode.content|striptags|truncate(120, true, " ", "…")|e }}</itunes:summary>
    {% set episode_image = episode.media[episode.header.podcast.itunes.image] ?: episode.media.images|first -%}
    {% if episode_image -%}
    <itunes:image href="{{ (uri.base ~ episode_image.url(true))|e('html_attr') }}"/>
    {% endif -%}
    {% if episode.header.audio_url -%}
    <enclosure length="{{ episode.header.audio_bytes }}" type="{{ episode.header.audio_mime|e('html_attr') }}" url="{{ (uri.base ~ episode.media[episode.header.audio_url].url(true))|e('html_attr') }}"/>
    <guid isPermaLink="false">{{ episode.header.guid|e }}</guid>
    {% elseif episode.header.podcast.audio.remote -%}
    <enclosure length="{{ episode.header.podcast.audio.meta.enclosure_length }}" type="{{ episode.header.podcast.audio.meta.type|e('html_attr') }}" url="{{ episode.header.podcast.audio.remote|e('html_attr') }}"/>
    <guid isPermaLink="false">{{ (episode.header.podcast.guid ?: episode.header.guid ?: episode.header.podcast.audio.remote)|e }}</guid>
    {% else -%}
    <enclosure length="{{ episode.header.podcast.audio.meta.enclosure_length }}" type="{{ episode.header.podcast.audio.meta.type|e('html_attr') }}" url="{{ (uri.base ~ episode.header.podcast.audio.meta.guid)|e('html_attr') }}"/>
    <guid isPermaLink="false">{{ (episode.header.podcast.guid ?: episode.header.guid ?: uri.base ~ episode.header.podcast.audio.meta.guid)|e }}</guid>
    {% endif -%}
    <pubDate>{{ episode.header.publish_date ? episode.header.publish_date|date('r') : episode.date|date('r') }}</pubDate>
    {% if episode.header.podcast.audio.meta.duration -%}
    <itunes:duration>{{ episode.header.podcast.audio.meta.duration }}</itunes:duration>
    {% elseif episode.header.audio_duration_seconds -%}
    <itunes:duration>{{ episode.header.audio_duration_seconds|round }}</itunes:duration>
    {% endif -%}
    <itunes:explicit>{{ episode.header.podcast.itunes.explicit ?: 'no' }}</itunes:explicit>
</item>
{% endif %}
{% endfor %}
</channel>
</rss>
{% endif %}
